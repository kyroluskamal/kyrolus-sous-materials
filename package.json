{
  "name": "kyrolus-sous-materials",
  "version": "1.0.0",
  "scripts": {
    "ng": "ng",
    "postinstall": "npm run ks:build-engine --silent",
    "start": "ng serve",
    "build": "ng build",
    "build:prod": "ng build --configuration production",
    "build:prod:purge": "npm run build:prod && npm run purge:css:safe",
    "watch": "ng build --watch --configuration development",
    "test:watch": "ng test --watch --coverage",
    "test": "ng test ",
    "test:purge": "node projects/kyrolus-sous-materials/scripts/purge-smoke.js",
    "export:tokens": "node projects/kyrolus-sous-materials/scripts/export-tokens.js",
    "export:classes": "node projects/kyrolus-sous-materials/scripts/export-classes.js",
    "test:visual": "cypress run --spec cypress/e2e/visual-baseline.cy.ts",
    "serve:ssr:ks-materials-docs": "node dist/ks-materials-docs/server/server.mjs",
    "cypress:open": "cypress open",
    "build:lib": "ng build kyrolus-sous-materials --watch ",
    "docs": "ng serve ks-materials-docs --port 4200 -o",
    "purge:css": "node projects/kyrolus-sous-materials/postbuild.js",
    "purge:css:safe": "node projects/kyrolus-sous-materials/postbuild-safe.js",
    "purge:css:custom": "node projects/kyrolus-sous-materials/postbuild.js",
    "ks:build-engine": "tsc -p projects/kyrolus-sous-materials/jit/tsconfig.json",
    "ks": "npm run ks:build-engine --silent && node projects/kyrolus-sous-materials/jit/dist/cli.js build",
    "ks:watch": "npm run ks:build-engine --silent && node projects/kyrolus-sous-materials/jit/dist/cli.js watch",
    "ks:init": "npm run ks:build-engine --silent && node projects/kyrolus-sous-materials/jit/dist/cli.js init",
    "ks:intellisense": "npm run ks:build-engine --silent && node projects/kyrolus-sous-materials/jit/dist/cli.js intellisense"
  },
  "prettier": {
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^22.0.8",
    "@angular/common": "^22.0.8",
    "@angular/compiler": "^22.0.8",
    "@angular/core": "^22.0.8",
    "@angular/forms": "^22.0.8",
    "@angular/platform-browser": "^22.0.8",
    "@angular/platform-server": "^22.0.8",
    "@angular/router": "^22.0.8",
    "@angular/ssr": "^22.0.9",
    "bootstrap-icons": "^1.13.1",
    "express": "^5.2.1",
    "marked": "^18.0.7",
    "material-icons": "^1.13.14",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular-devkit/architect": "0.2200.9",
    "@angular/build": "^22.0.9",
    "@angular/cli": "^22.0.9",
    "@angular/compiler-cli": "^22.0.8",
    "@fullhuman/postcss-purgecss": "^8.0.0",
    "@kyrolus-sous-materials/jit": "file:./projects/kyrolus-sous-materials/jit",
    "@types/express": "^5.0.6",
    "@types/jasmine": "~6.0.0",
    "@types/node": "^24.13.3",
    "@vitest/coverage-v8": "^4.1.10",
    "autoprefixer": "^10.5.4",
    "cssnano": "^8.0.2",
    "cypress": "^15.19.0",
    "jasmine-core": "~6.3.0",
    "jsdom": "^30.0.1",
    "karma": "~6.4.4",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.1",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.2.0",
    "ng-packagr": "^22.1.0",
    "postcss": "^8.5.24",
    "postcss-prefix-selector": "^2.1.1",
    "postcss-selector-parser": "^7.1.4",
    "purgecss": "^8.0.0",
    "typescript": "~6.0.3",
    "user-agent-data-types": "^0.4.3",
    "vitest": "^4.1.10"
  }
}
